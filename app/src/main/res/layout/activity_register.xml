<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    tools:context=".RegisterActivity">

    <LinearLayout
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="24dp"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/imageView3"
            android:layout_width="wrap_content"
            android:layout_height="120dp"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="24dp"
            android:contentDescription="Logo de la aplicación"
            android:src="@drawable/logo" />

        <TextView
            android:id="@+id/lbl_nombre"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Nombre y Apellido:"
            android:textSize="20sp"
            android:textColor="#000000"
            android:layout_marginBottom="6dp" />

        <EditText
            android:id="@+id/et_nombre"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:inputType="textPersonName"
            android:hint="Ej: Juana Pérez"
            android:textSize="18sp"
            android:padding="12dp"
            android:background="?android:attr/editTextBackground"
            android:layout_marginBottom="20dp" />

        <TextView
            android:id="@+id/lbl_correo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Correo electrónico:"
            android:textSize="20sp"
            android:textColor="#000000"
            android:layout_marginBottom="6dp" />

        <EditText
            android:id="@+id/et_correo"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:inputType="textEmailAddress"
            android:hint="Ej: juana.perez@vitus.com"
            android:textSize="18sp"
            android:padding="12dp"
            android:background="?android:attr/editTextBackground"
            android:layout_marginBottom="20dp" />

        <TextView
            android:id="@+id/lbl_cedula"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Número de Cédula:"
            android:textSize="20sp"
            android:textColor="#000000"
            android:layout_marginBottom="6dp" />

        <EditText
            android:id="@+id/et_cedula"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:inputType="number"
            android:hint="Ej: 1712345678"
            android:maxLength="10"
            android:textSize="18sp"
            android:padding="12dp"
            android:background="?android:attr/editTextBackground"
            android:layout_marginBottom="20dp" />

        <TextView
            android:id="@+id/lbl_celular"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Número de Celular:"
            android:textSize="20sp"
            android:textColor="#000000"
            android:layout_marginBottom="6dp" />

        <EditText
            android:id="@+id/et_celular"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:inputType="phone"
            android:hint="Ej: 0991234567"
            android:maxLength="10"
            android:textSize="18sp"
            android:padding="12dp"
            android:background="?android:attr/editTextBackground"
            android:layout_marginBottom="20dp" />

        <TextView
            android:id="@+id/lbl_anio"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Fecha de Nacimiento:"
            android:textSize="20sp"
            android:textColor="#000000"
            android:layout_marginBottom="6dp" />

        <EditText
            android:id="@+id/et_anio"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:focusable="false"
            android:clickable="true"
            android:hint="Seleccione su fecha"
            android:textSize="18sp"
            android:padding="12dp"
            android:background="?android:attr/editTextBackground"
            android:layout_marginBottom="20dp" />

        <TextView
            android:id="@+id/lbl_pin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="PIN de Acceso (4 números):"
            android:textSize="20sp"
            android:textColor="#000000"
            android:layout_marginBottom="6dp" />

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:passwordToggleEnabled="true"
            android:layout_marginBottom="10dp">
            <EditText
                android:id="@+id/et_pin"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:inputType="numberPassword"
                android:hint="Ej: 1234"
                android:maxLength="4"
                android:textSize="18sp"
                android:padding="12dp"
                android:background="?android:attr/editTextBackground" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            android:id="@+id/lbl_pin_confirm"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Repetir PIN:"
            android:textSize="20sp"
            android:textColor="#000000"
            android:layout_marginBottom="6dp" />

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:passwordToggleEnabled="true"
            android:layout_marginBottom="32dp">
            <EditText
                android:id="@+id/et_pin_confirm"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:inputType="numberPassword"
                android:hint="Repita su PIN"
                android:maxLength="4"
                android:textSize="18sp"
                android:padding="12dp"
                android:background="?android:attr/editTextBackground" />
        </com.google.android.material.textfield.TextInputLayout>

        <Button
            android:id="@+id/btn_registro"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginBottom="16dp"
            android:backgroundTint="#5c8c6e"
            android:text="Crear mi cuenta"
            android:textColor="#E1DCDC"
            android:textSize="20sp"
            android:textStyle="bold"
            app:cornerRadius="20dp" />

    </LinearLayout>
</ScrollView>
