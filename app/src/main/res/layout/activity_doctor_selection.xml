<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#E9EAED"
    android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_margin="8dp" android:background="#FCFBF7" android:orientation="vertical" android:padding="18dp">
        <TextView android:id="@+id/btn_back" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:text="← Especialidades" android:textColor="#5E8F73" android:textSize="15sp" />
        <View android:layout_width="match_parent" android:layout_height="4dp" android:layout_marginTop="14dp" android:background="#5E8F73" />
        <TextView android:id="@+id/txt_specialty" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:text="Med. General" android:textColor="#17324F" android:textSize="23sp" android:textStyle="bold" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Elija su médico" android:textColor="#6F7782" android:textSize="14sp" />
        <androidx.cardview.widget.CardView android:id="@+id/card_doctor_one" android:layout_width="match_parent" android:layout_height="70dp" android:layout_marginTop="18dp" android:clickable="true" android:foreground="?android:attr/selectableItemBackground" app:cardBackgroundColor="#EAF4EE" app:cardCornerRadius="18dp" app:cardElevation="0dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center_vertical" android:orientation="horizontal" android:paddingHorizontal="14dp"><TextView android:id="@+id/txt_initials_one" android:layout_width="42dp" android:layout_height="42dp" android:background="#EAF4EE" android:gravity="center" android:textColor="#5E8F73" android:textSize="16sp" android:textStyle="bold" /><LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:layout_weight="1" android:orientation="vertical"><TextView android:id="@+id/txt_doctor_one" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#17324F" android:textSize="16sp" android:textStyle="bold" /><TextView android:id="@+id/txt_schedule_one" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#6F7782" android:textSize="13sp" /></LinearLayout><TextView android:id="@+id/txt_check_one" android:layout_width="28dp" android:layout_height="28dp" android:background="#5E8F73" android:gravity="center" android:text="✓" android:textColor="#FFFFFF" android:textSize="18sp" /></LinearLayout>
        </androidx.cardview.widget.CardView>
        <androidx.cardview.widget.CardView android:id="@+id/card_doctor_two" android:layout_width="match_parent" android:layout_height="70dp" android:layout_marginTop="10dp" android:clickable="true" android:foreground="?android:attr/selectableItemBackground" app:cardBackgroundColor="#FCFBF7" app:cardCornerRadius="18dp" app:cardElevation="1dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center_vertical" android:orientation="horizontal" android:paddingHorizontal="14dp"><TextView android:id="@+id/txt_initials_two" android:layout_width="42dp" android:layout_height="42dp" android:background="#F1F4F6" android:gravity="center" android:textColor="#17324F" android:textSize="16sp" android:textStyle="bold" /><LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:layout_weight="1" android:orientation="vertical"><TextView android:id="@+id/txt_doctor_two" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#17324F" android:textSize="16sp" android:textStyle="bold" /><TextView android:id="@+id/txt_schedule_two" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#6F7782" android:textSize="13sp" /></LinearLayout><TextView android:id="@+id/txt_check_two" android:layout_width="28dp" android:layout_height="28dp" android:gravity="center" android:text="✓" android:textColor="#FFFFFF" android:textSize="18sp" android:visibility="invisible" /></LinearLayout>
        </androidx.cardview.widget.CardView>
        <androidx.cardview.widget.CardView android:id="@+id/card_doctor_three" android:layout_width="match_parent" android:layout_height="70dp" android:layout_marginTop="10dp" android:clickable="true" android:foreground="?android:attr/selectableItemBackground" app:cardBackgroundColor="#FCFBF7" app:cardCornerRadius="18dp" app:cardElevation="1dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center_vertical" android:orientation="horizontal" android:paddingHorizontal="14dp"><TextView android:id="@+id/txt_initials_three" android:layout_width="42dp" android:layout_height="42dp" android:background="#FCECEE" android:gravity="center" android:textColor="#C53030" android:textSize="16sp" android:textStyle="bold" /><LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:layout_weight="1" android:orientation="vertical"><TextView android:id="@+id/txt_doctor_three" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#17324F" android:textSize="16sp" android:textStyle="bold" /><TextView android:id="@+id/txt_schedule_three" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#6F7782" android:textSize="13sp" /></LinearLayout><TextView android:id="@+id/txt_check_three" android:layout_width="28dp" android:layout_height="28dp" android:gravity="center" android:text="✓" android:textColor="#FFFFFF" android:textSize="18sp" android:visibility="invisible" /></LinearLayout>
        </androidx.cardview.widget.CardView>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:background="#EFF2F0" android:orientation="vertical" android:padding="14dp"><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="⌕  ¿Necesita ayuda?" android:textColor="#5E8F73" android:textSize="14sp" android:textStyle="bold" /><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="7dp" android:text="Llame al 1800-VITUS o pida asistencia en recepción. Estamos disponibles de lunes a viernes, 8am – 6pm." android:textColor="#6F7782" android:textSize="13sp" /></LinearLayout>
        <Button android:id="@+id/btn_continue" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="28dp" android:backgroundTint="#5E8F73" android:text="Continuar" android:textColor="#FFFFFF" android:textStyle="bold" />
    </LinearLayout>
</ScrollView>
