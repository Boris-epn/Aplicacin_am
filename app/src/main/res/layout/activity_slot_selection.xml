<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#E9EAED"
    android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_margin="8dp" android:background="#FCFBF7" android:orientation="vertical" android:padding="18dp">
        <TextView android:id="@+id/btn_back" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:text="← Médicos" android:textColor="#5E8F73" android:textSize="15sp" />
        <View android:layout_width="match_parent" android:layout_height="4dp" android:layout_marginTop="14dp" android:background="#5E8F73" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:gravity="center_vertical" android:orientation="horizontal"><TextView android:id="@+id/txt_initials" android:layout_width="40dp" android:layout_height="40dp" android:background="#EAF4EE" android:gravity="center" android:textColor="#5E8F73" android:textSize="15sp" android:textStyle="bold" /><LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="10dp" android:orientation="vertical"><TextView android:id="@+id/txt_doctor" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#17324F" android:textSize="17sp" android:textStyle="bold" /><TextView android:id="@+id/txt_specialty" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#6F7782" android:textSize="13sp" /></LinearLayout></LinearLayout>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:layout_marginBottom="10dp" android:text="Elija fecha y hora" android:textColor="#6F7782" android:textSize="14sp" />
        <androidx.cardview.widget.CardView android:id="@+id/card_slot_one" android:layout_width="match_parent" android:layout_height="54dp" android:clickable="true" app:cardBackgroundColor="#173B63" app:cardCornerRadius="17dp" app:cardElevation="0dp"><LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center_vertical" android:orientation="horizontal" android:paddingHorizontal="16dp"><LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical"><TextView android:id="@+id/txt_date_one" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#FFFFFF" android:textSize="16sp" android:textStyle="bold" /><TextView android:id="@+id/txt_time_one" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#FFFFFF" android:textSize="13sp" /></LinearLayout><TextView android:id="@+id/txt_status_one" android:layout_width="30dp" android:layout_height="30dp" android:background="#5E8F73" android:gravity="center" android:text="✓" android:textColor="#FFFFFF" android:textSize="18sp" /></LinearLayout></androidx.cardview.widget.CardView>
        <androidx.cardview.widget.CardView android:id="@+id/card_slot_two" android:layout_width="match_parent" android:layout_height="54dp" android:layout_marginTop="10dp" android:clickable="true" app:cardBackgroundColor="#FFFFFF" app:cardCornerRadius="17dp" app:cardElevation="1dp"><LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center_vertical" android:orientation="horizontal" android:paddingHorizontal="16dp"><LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical"><TextView android:id="@+id/txt_date_two" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#17324F" android:textSize="16sp" android:textStyle="bold" /><TextView android:id="@+id/txt_time_two" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#6F7782" android:textSize="13sp" /></LinearLayout><TextView android:id="@+id/txt_status_two" android:layout_width="60dp" android:layout_height="30dp" android:gravity="center" android:textColor="#6F7782" android:textSize="12sp" /></LinearLayout></androidx.cardview.widget.CardView>
        <androidx.cardview.widget.CardView android:id="@+id/card_slot_three" android:layout_width="match_parent" android:layout_height="54dp" android:layout_marginTop="10dp" android:clickable="true" app:cardBackgroundColor="#FFFFFF" app:cardCornerRadius="17dp" app:cardElevation="1dp"><LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center_vertical" android:orientation="horizontal" android:paddingHorizontal="16dp"><LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical"><TextView android:id="@+id/txt_date_three" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#17324F" android:textSize="16sp" android:textStyle="bold" /><TextView android:id="@+id/txt_time_three" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#6F7782" android:textSize="13sp" /></LinearLayout><TextView android:id="@+id/txt_status_three" android:layout_width="60dp" android:layout_height="30dp" android:gravity="center" android:textColor="#6F7782" android:textSize="12sp" /></LinearLayout></androidx.cardview.widget.CardView>
        <androidx.cardview.widget.CardView android:id="@+id/card_slot_four" android:layout_width="match_parent" android:layout_height="54dp" android:layout_marginTop="10dp" android:clickable="true" app:cardBackgroundColor="#FFFFFF" app:cardCornerRadius="17dp" app:cardElevation="1dp"><LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center_vertical" android:orientation="horizontal" android:paddingHorizontal="16dp"><LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical"><TextView android:id="@+id/txt_date_four" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#17324F" android:textSize="16sp" android:textStyle="bold" /><TextView android:id="@+id/txt_time_four" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#6F7782" android:textSize="13sp" /></LinearLayout><TextView android:id="@+id/txt_status_four" android:layout_width="60dp" android:layout_height="30dp" android:gravity="center" android:textColor="#6F7782" android:textSize="12sp" /></LinearLayout></androidx.cardview.widget.CardView>
        <androidx.cardview.widget.CardView android:id="@+id/card_slot_five" android:layout_width="match_parent" android:layout_height="54dp" android:layout_marginTop="10dp" android:clickable="true" app:cardBackgroundColor="#FFFFFF" app:cardCornerRadius="17dp" app:cardElevation="1dp"><LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center_vertical" android:orientation="horizontal" android:paddingHorizontal="16dp"><LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical"><TextView android:id="@+id/txt_date_five" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#17324F" android:textSize="16sp" android:textStyle="bold" /><TextView android:id="@+id/txt_time_five" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#6F7782" android:textSize="13sp" /></LinearLayout><TextView android:id="@+id/txt_status_five" android:layout_width="60dp" android:layout_height="30dp" android:gravity="center" android:textColor="#6F7782" android:textSize="12sp" /></LinearLayout></androidx.cardview.widget.CardView>
        <Button android:id="@+id/btn_confirm" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="48dp" android:backgroundTint="#5E8F73" android:textColor="#FFFFFF" android:textStyle="bold" />
    </LinearLayout>
</ScrollView>
